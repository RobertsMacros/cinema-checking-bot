# OMDb API key (free: https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=

# TMDB API key (free: https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# SMTP settings (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Set to true to print digest instead of emailing
DRY_RUN=false
